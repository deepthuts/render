# .env.example (Safe to push to GitHub)
N8N_VERSION=
WEBHOOK_URL=
N8N_ENCRYPTION_KEY=

N8N_NATIVE_PYTHON_RUNNER=false
# Keep community nodes working smoothly
N8N_UNVERIFIED_PACKAGES_ENABLED=true

# Keep your current 5-minute timeout for tasks
N8N_RUNNERS_TASK_TIMEOUT=300

# Maintain current compression node limits
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=10000


# If using Postgres:
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_POSTGRESDB_PORT=6543
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.iiavksradaofebbybzgw
DB_POSTGRESDB_PASSWORD=Dar456ling@
